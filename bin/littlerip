#!/usr/bin/env node

'use strict';

const { version } = require('../package.json');

const WORD = 'littlerip';
const args = process.argv.slice(2);

if (args.length > 0) {
  const option = args[0];

  if (option === '-v' || option === '--version') {
    process.stdout.write(`${version}\n`);
    process.exit(0);
  }

  if (option === '-h' || option === '--help') {
    process.stdout.write([
      'Usage: littlerip',
      '',
      'Opens a terminal screen that says littlerip.',
      'Press Ctrl+C to leave.',
      '',
    ].join('\n'));
    process.exit(0);
  }

  process.stderr.write(`littlerip: unknown option: ${option}\n`);
  process.stderr.write('Try littlerip --help\n');
  process.exit(2);
}

// Keep redirected output simple and useful.
if (!process.stdin.isTTY || !process.stdout.isTTY) {
  process.stdout.write(`${WORD}\n`);
  process.exit(0);
}

let cleanedUp = false;
let rawModeEnabled = false;

function render() {
  const columns = Math.max(1, process.stdout.columns || 80);
  const rows = Math.max(1, process.stdout.rows || 24);
  const row = Math.max(1, Math.floor((rows + 1) / 2));
  const column = Math.max(1, Math.floor((columns - WORD.length) / 2) + 1);

  process.stdout.write(`\u001b[2J\u001b[H\u001b[${row};${column}H${WORD}`);
}

function cleanup() {
  if (cleanedUp) return;
  cleanedUp = true;

  process.stdout.off('resize', render);

  if (rawModeEnabled) {
    process.stdin.setRawMode(false);
  }

  process.stdin.pause();
  process.stdout.write('\u001b[?25h\u001b[?1049l');
}

function quit() {
  cleanup();
  process.exitCode = 0;
}

process.once('SIGINT', quit);
process.once('SIGTERM', quit);
process.once('SIGHUP', quit);
process.once('exit', cleanup);
process.stdout.on('resize', render);

// Use the terminal's alternate screen so the original prompt returns cleanly.
process.stdout.write('\u001b[?1049h\u001b[?25l');

if (typeof process.stdin.setRawMode === 'function') {
  process.stdin.setRawMode(true);
  rawModeEnabled = true;
}

process.stdin.resume();
process.stdin.on('data', (data) => {
  if (data.includes(3)) quit();
});

render();
