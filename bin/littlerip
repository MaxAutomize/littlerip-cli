#!/bin/sh

VERSION="1.0.0"

case "${1-}" in
  "") ;;
  -v|--version)
    printf '%s\n' "$VERSION"
    exit 0
    ;;
  -h|--help)
    printf '%s\n' \
      'Usage: littlerip' \
      '' \
      'Opens a terminal screen that says littlerip.' \
      'Press Ctrl+C to leave.'
    exit 0
    ;;
  *)
    printf 'littlerip: unknown option: %s\n' "$1" >&2
    printf 'Try littlerip --help\n' >&2
    exit 2
    ;;
esac

# Keep redirected output simple and useful.
if [ ! -t 0 ] || [ ! -t 1 ]; then
  printf '%s\n' 'littlerip'
  exit 0
fi

saved_terminal_settings=$(stty -g 2>/dev/null || true)

cleanup() {
  if [ -n "$saved_terminal_settings" ]; then
    stty "$saved_terminal_settings" 2>/dev/null || true
  fi
  printf '\033[?25h\033[?1049l'
}

render() {
  cols=$(tput cols 2>/dev/null || printf '80')
  rows=$(tput lines 2>/dev/null || printf '24')

  case "$cols" in *[!0-9]*|'') cols=80 ;; esac
  case "$rows" in *[!0-9]*|'') rows=24 ;; esac
  [ "$cols" -lt 1 ] && cols=80
  [ "$rows" -lt 1 ] && rows=24

  word='littlerip'
  word_length=9
  row=$(( (rows + 1) / 2 ))
  col=$(( (cols - word_length) / 2 + 1 ))
  [ "$col" -lt 1 ] && col=1

  printf '\033[2J\033[H\033[%s;%sH%s' "$row" "$col" "$word"
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM
trap render WINCH

# Use the terminal's alternate screen so the original prompt returns cleanly.
printf '\033[?1049h\033[?25l'
[ -n "$saved_terminal_settings" ] && stty -echo 2>/dev/null || true
render

# Stay open without showing anything the user happens to type.
while :; do sleep 1; done
